{
	"schemaVersion": 1,
	"id": "demistorm_template",
	"version": "${version}",
	"name": "Demistorm Template",
	"description": "Architectury multi-loader mixin template for Minecraft 1.21.11.",
	"authors": [
		"demistorm"
	],
	"contact": {
		"homepage": "https://github.com/demistorm",
		"sources": "https://github.com/demistorm"
	},
	"license": "GPL-3.0",
	"environment": "*",
	"entrypoints": {
		"main": [
			"win.demistorm.template.fabric.DemistormTemplateFabric"
		],
		"client": [
			"win.demistorm.template.fabric.client.FabricClient"
		]
	},
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "${minecraft_version}",
		"java": ">=21",
		"fabric-api": "*"
	},
	"recommends": {
		"vivecraft": ">=1.3.3"
	},
	"mixins": [
		"demistorm_template.mixins.json"
